{
  "name": "obs-mcp",
  "version": "1.1.1",
  "description": "MCP server for OBS Studio",
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=20.17"
  },
  "type": "module",
  "bin": {
    "obs-mcp": "./build/index.js"
  },
  "main": "build/index.js",
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "start": "node build/index.js",
    "pack": "node scripts/pack.mjs",
    "test": "vitest run",
    "validate:manifest": "mcpb validate manifest.json",
    "check": "npm run build && npm test && npm run validate:manifest"
  },
  "files": [
    "build",
    "docs/protocol.json"
  ],
  "dependencies": {
    "ws": "8.21.3",
    "zod": "4.4.3",
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@anthropic-ai/mcpb": {
      "@inquirer/prompts": "8.6.0"
    }
  }
}
