{
  "name": "obs-mcp",
  "version": "1.1.1",
  "description": "Inspect, plan and supervise OBS Studio workflows through MCP",
  "license": "GPL-2.0-only",
  "author": {
    "name": "Thomas Main",
    "url": "https://github.com/Tom-R-Main"
  },
  "contributors": [
    {
      "name": "Roy Shilkrot",
      "url": "https://github.com/royshil"
    },
    {
      "name": "Zeke Sikelianos",
      "url": "https://github.com/zeke"
    },
    {
      "name": "Jag-k",
      "url": "https://github.com/jag-k"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tom-R-Main/OBS-MCP.git"
  },
  "homepage": "https://github.com/Tom-R-Main/OBS-MCP#readme",
  "bugs": {
    "url": "https://github.com/Tom-R-Main/OBS-MCP/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "bin": {
    "obs-mcp": "./build/index.js"
  },
  "main": "build/index.js",
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "start": "native/target/release/obs-mcp-native",
    "pack": "node scripts/pack.mjs",
    "test": "npm run test:unit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "vitest run --config vitest.e2e.config.ts",
    "test:package": "npm run pack && npm run test:package:run",
    "test:package:run": "vitest run --config vitest.package.config.ts",
    "test:obs-live": "npm run build && vitest run --config vitest.live.config.ts",
    "validate:manifest": "mcpb validate manifest.json",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check": "npm run check:dependencies && npm run build && npm run typecheck:test && npm run test:unit && npm run test:e2e:run && npm run validate:manifest",
    "native:contract": "npm run build && node scripts/export-native-contract.mjs && node scripts/export-native-prompts.mjs",
    "native:build": "npm run build && node scripts/build-native.mjs",
    "native:test": "vitest run --config vitest.native.config.ts",
    "native:ratchet": "node scripts/check-native-migration.mjs",
    "native:licenses": "node scripts/check-native-licenses.mjs",
    "pack:native": "node scripts/pack.mjs --native",
    "native:check": "node scripts/check-native.mjs",
    "start:compat": "node build/index.js"
  },
  "files": [
    "build",
    "src",
    "scripts",
    "docs/protocol.json",
    "docs/production-assistant.md",
    "tsconfig.json",
    "manifest.json",
    "icon.png",
    "assets/identity",
    "NOTICE.md",
    ".agents/skills/obs-demo",
    "docs/recipes",
    "native/src",
    "native/tests",
    "native/assets",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/rust-toolchain.toml",
    "docs/native-architecture.md",
    "docs/full-rust-cutover.md",
    "docs/native-dependencies.md",
    "docs/native-migration-ledger.json"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@anthropic-ai/mcpb": {
      "@inquirer/prompts": "8.6.0"
    }
  }
}
